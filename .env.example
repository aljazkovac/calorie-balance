# Copy to .env and fill in. .env is gitignored — never commit real values.

ANTHROPIC_API_KEY=

# Strava app: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# Body data for the BMR estimate (Mifflin–St Jeor)
BMR_WEIGHT_KG=
BMR_HEIGHT_CM=
BMR_AGE=
BMR_SEX=
BMR_ACTIVITY_FACTOR=1.2
